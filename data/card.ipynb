import json
import os

BASE_DIR = os.path.dirname(os.path.abspath(__file__))
INPUT_JSON = os.path.join(BASE_DIR, "../data/raw/card.json")
OUTPUT_FASTA = os.path.join(BASE_DIR, "../results/all_drugs_plm_dataset.fasta")
OUTPUT_MAPPING = os.path.join(BASE_DIR, "../results/drug_class_mapping.json")

def prepare_all_drugs_dataset():
    if not os.path.exists(INPUT_JSON):
        print(f"Error: Berkas {INPUT_JSON} tidak ditemukan!")
        return

    print("[*] Membuka basis data mentah CARD...")
    with open(INPUT_JSON, 'r', encoding='utf-8') as f:
        card_data = json.load(f)

    # LANGKAH 1: Kumpulkan semua Drug Class unik secara dinamis
    unique_drug_classes = set()
    for model_id, gene_entry in card_data.items():
        if isinstance(gene_entry, dict):
            aro_categories = gene_entry.get("ARO_category", {})
            for cat in aro_categories.values():
                if cat.get("category_aro_class_name") == "Drug Class":
                    drug_name = cat.get("category_aro_name", "").strip()
                    if drug_name:
                        unique_drug_classes.add(drug_name)

    # Urutkan dan buat pemetaan indeks (Mapping)
    sorted_drugs = sorted(list(unique_drug_classes))
    drug_to_index = {drug: idx for idx, drug in enumerate(sorted_drugs)}
    num_classes = len(sorted_drugs)
    
    print(f"[V] Berhasil mendeteksi {num_classes} golongan obat (Drug Class) unik di CARD.")
    
    # Simpan indeks pemetaan obat ke file JSON untuk referensi MLP Anda nanti
    with open(OUTPUT_MAPPING, 'w', encoding='utf-8') as json_out:
        json.dump(drug_to_index, json_out, indent=4)
    print(f"[V] Peta indeks obat disimpan di: results/drug_class_mapping.json")

    # LANGKAH 2: Ekstrak Sekuens dan Susun Vektor Multi-Label
    count_sequences = 0
    print("[*] Memulai ekstraksi sekuens dan pembuatan vektor multi-label...")

    with open(OUTPUT_FASTA, 'w', encoding='utf-8') as fasta_file:
        for model_id, gene_entry in card_data.items():
            if not isinstance(gene_entry, dict):
                continue
            
            aro_categories = gene_entry.get("ARO_category", {})
            model_sequences = gene_entry.get("model_sequences", {}).get("sequence", {})
            
            # Inisialisasi vektor biner berukuran 196 dengan angka 0
            multilabel_vector = [0] * num_classes
            is_resistant_gene = False
            
            for cat in aro_categories.values():
                if cat.get("category_aro_class_name") == "Drug Class":
                    drug_name = cat.get("category_aro_name", "").strip()
                    if drug_name in drug_to_index:
                        idx = drug_to_index[drug_name]
                        multilabel_vector[idx] = 1
                        is_resistant_gene = True
            
            # Ekstrak jika gen ini memiliki resistensi terhadap golongan obat apa pun
            if is_resistant_gene and model_sequences:
                gene_name = gene_entry.get("ARO_name", "Unknown").replace(" ", "_")
                aro_accession = gene_entry.get("ARO_accession", "Unknown")
                
                for seq_id, seq_info in model_sequences.items():
                    protein_info = seq_info.get("protein_sequence", {})
                    seq_text = protein_info.get("sequence", "")
                    
                    if seq_text:
                        # Ubah vektor list [1, 0, 1...] menjadi string "101..." agar hemat ruang di header FASTA
                        vector_str = "".join(map(str, multilabel_vector))
                        
                        # Tulis ke file FASTA
                        fasta_file.write(f">{gene_name}_seq{seq_id}|ARO_{aro_accession}|LABELS:{vector_str}\n")
                        fasta_file.write(f"{seq_text}\n")
                        count_sequences += 1

    print("\n=== DATASET SELESAI DISEDIAKAN ===")
    print(f"[V] Total Sekuens Protein terekstrak: {count_sequences}")
    print(f"[V] Panjang Vektor Target MLP       : {num_classes} dimensi (Multi-Label)")
    print(f"[V] Dataset FASTA disimpan di       : results/all_drugs_plm_dataset.fasta\n")

if __name__ == "__main__":
    prepare_all_drugs_dataset()
